{
  "name": "xpict-web",
  "version": "0.1.0",
  "description": "Xpict Web is the browser-based version of Xpict: the generation of standardized images from declarative models using Canvas.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/*",
    "!/**/__tests__"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc",
    "format": "prettier --write \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "lint": "eslint src __tests__",
    "lint:fix": "eslint src __tests__ --fix"
  },
  "keywords": [
    "xpict",
    "image",
    "template",
    "canvas",
    "browser"
  ],
  "author": "Marcuth",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^0.1.88",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.8.1",
    "prettier-plugin-sort-imports": "^1.8.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
